# ============================================================
# 环境变量示例
#
# 用法：复制为 deploy/.env 后填入真实值。
#   cp deploy/.env.example deploy/.env
#
# 约定：
#   1. deploy/.env 已在 .gitignore 中，绝不提交
#   2. 本文件只放占位值，不得写入任何真实凭据
#   3. 带 :? 的变量在 compose 中为必填，缺失会直接报错而不是用弱默认值启动
# ============================================================

# ---------- MySQL（容器实例）----------
# 仅在使用 compose 的 mysql 服务时需要
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=change_me_blog_password
# 宿主机 3306 常被本地 MySQL 占用，默认映射到 3307
MYSQL_HOST_PORT=3307

# ---------- Redis（本项目独立实例 blog-redis）----------
# 密码必填。生成方式：openssl rand -base64 24
REDIS_PASSWORD=change_me_redis_password
# 宿主机 6379 常被其他 Redis 占用，默认映射到 6380
REDIS_HOST_PORT=6380

# ---------- Meilisearch ----------
MEILI_MASTER_KEY=change_me_meili_master_key
MEILI_ENV=development
MEILI_HOST_PORT=7700

# ---------- MinIO ----------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---------- 应用 ----------
# 本地开发运行 go run ./cmd/server -env-file deploy/.env 时读取以下变量
BLOG_APP_ENV=development
BLOG_APP_ADDR=:8080
BLOG_APP_VERSION=dev
BLOG_LOG_LEVEL=debug
BLOG_LOG_FORMAT=text

# 数据库连接串。二选一：
#   A. 用宿主机已安装的 MySQL（本地开发默认）
#      BLOG_DB_DSN=root:你的密码@tcp(127.0.0.1:3306)/blog?charset=utf8mb4&parseTime=true&loc=Local
#   B. 用 compose 起的 mysql（宿主机端口 3307）
#      BLOG_DB_DSN=blog:你的密码@tcp(127.0.0.1:3307)/blog?charset=utf8mb4&parseTime=true&loc=Local
BLOG_DB_DSN=blog:change_me_blog_password@tcp(127.0.0.1:3307)/blog?charset=utf8mb4&parseTime=true&loc=Local

# Redis：地址、密码、库编号都必须可配，源码中不写死
# 用 compose 的 blog-redis 时，宿主机侧地址是 127.0.0.1:6380
BLOG_REDIS_ADDR=127.0.0.1:6380
BLOG_REDIS_PASSWORD=change_me_redis_password
BLOG_REDIS_DB=0

# 检索服务，留空表示本阶段未启用（/readyz 会跳过该项）
# 留空 = 不启用检索（/readyz 不检查，搜索接口降级为空结果）
BLOG_SEARCH_HOST=
BLOG_SEARCH_API_KEY=
BLOG_SEARCH_INDEX=articles
BLOG_SEARCH_TIMEOUT_SEC=3

# JWT 签名密钥，至少 32 字符。阶段 2 起强校验。
BLOG_JWT_SECRET=change_me_at_least_32_characters_long

# ---------- 认证 ----------
BLOG_JWT_ISSUER=go-blog
BLOG_JWT_ACCESS_TTL_MIN=15
# 生产必须为 true（config 会强制）
BLOG_COOKIE_SECURE=false
BLOG_COOKIE_SAME_SITE=lax

# 邮件：本地用 console（链接打到日志），生产改 smtp
BLOG_MAIL_DRIVER=console
BLOG_MAIL_FROM=no-reply@blog.local
BLOG_MAIL_VERIFY_URL_BASE=http://localhost:3000/verify-email
BLOG_MAIL_RESET_URL_BASE=http://localhost:3000/reset-password

# ---------- 存储 ----------
# local：本地文件系统（开发与单实例部署）
# s3：MinIO / S3 兼容对象存储，V1.0 尚未实现，配置后启动会明确报错
BLOG_STORAGE_DRIVER=local
# 本地根目录，必须挂载持久化卷；相对路径基于进程工作目录
BLOG_STORAGE_LOCAL_ROOT=var/storage
# 对外访问前缀（不含末尾斜杠）：本地由应用自身提供，MinIO 部署时改为桶域名/CDN
BLOG_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8080/api/v1/media
BLOG_STORAGE_MAX_IMAGE_MB=10

# ---------- 前端口与站点地址 ----------
# 宿主机映射端口（不影响容器内 3000/80）
WEB_HOST_PORT=3000
NGINX_HOST_PORT=80
# 对外访问地址：canonical / OG / sitemap 用它拼绝对链接，部署时改成真实域名
SITE_URL=http://localhost
# 浏览器连接 WebSocket 的地址；留空表示按当前域名推导（生产推荐留空，由 Nginx 代理 /ws）
WS_PUBLIC_UPSTREAM=
